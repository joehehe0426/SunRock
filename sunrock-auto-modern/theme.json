{
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "color": {
      "custom": false,
      "palette": [
        { "slug": "bg", "color": "#0B1220", "name": "Background" },
        { "slug": "surface", "color": "#111A2E", "name": "Surface" },
        { "slug": "text", "color": "#EAF0FF", "name": "Text" },
        { "slug": "muted", "color": "#A9B4D0", "name": "Muted" },
        { "slug": "accent", "color": "#F97316", "name": "Orange Accent" },
        { "slug": "accent-2", "color": "#FDBA74", "name": "Orange Soft" },
        { "slug": "line", "color": "rgba(255,255,255,0.12)", "name": "Line" }
      ]
    },
    "typography": {
      "customFontSize": false,
      "fontFamilies": [
        {
          "fontFamily": "Inter, system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif",
          "slug": "inter",
          "name": "Inter"
        }
      ],
      "fontSizes": [
        { "slug": "s", "size": "0.95rem", "name": "Small" },
        { "slug": "m", "size": "1.05rem", "name": "Medium" },
        { "slug": "l", "size": "1.25rem", "name": "Large" },
        { "slug": "xl", "size": "1.6rem", "name": "XL" }
      ]
    },
    "spacing": {
      "customSpacingSize": true,
      "spacingSizes": [
        { "slug": "1", "size": "0.5rem", "name": "1" },
        { "slug": "2", "size": "0.75rem", "name": "2" },
        { "slug": "3", "size": "1rem", "name": "3" },
        { "slug": "4", "size": "1.5rem", "name": "4" },
        { "slug": "5", "size": "2rem", "name": "5" },
        { "slug": "6", "size": "3rem", "name": "6" }
      ]
    }
  },
  "styles": {
    "typography": { "fontFamily": "var(--wp--preset--font-family--inter)" },
    "color": {
      "background": "var(--wp--preset--color--bg)",
      "text": "var(--wp--preset--color--text)"
    },
    "elements": {
      "link": {
        "color": { "text": "var(--wp--preset--color--text)" },
        ":hover": { "color": { "text": "var(--wp--preset--color--accent)" } }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--accent)",
          "text": "#0B1220"
        },
        "border": { "radius": "999px" },
        "spacing": {
          "padding": { "top": "0.75rem", "right": "1.1rem", "bottom": "0.75rem", "left": "1.1rem" }
        }
      }
    }
  }
}

